<?xml version="1.0" encoding="utf-8"?>
<!-- The Android 12+ splash: the glass logo settles in and a shine crosses it.
     Under a second, and the system ends it as soon as the first frame is ready. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_logo">
    <target android:name="all">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.86" android:valueTo="1" android:duration="420" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.86" android:valueTo="1" android:duration="420" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="shine">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateX" android:valueFrom="-200" android:valueTo="200" android:startOffset="200" android:duration="600" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
